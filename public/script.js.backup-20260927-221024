function shareVideo() {
    if (!currentVideo) return;

    const url =
        window.location.origin +
        window.location.pathname +
        `?video=${encodeURIComponent(currentVideo.id)}`;

    if (navigator.share) {

        navigator.share({
            title: currentVideo.title || "Flickora",
            text: "Watch this on Flickora",
            url
        }).catch(() => {});

    } else {

        navigator.clipboard
            ?.writeText(url)
            .then(() => {
                alert("Video link copied!");
            })
            .catch(() => {
                prompt("Copy this link:", url);
            });
    }
}


