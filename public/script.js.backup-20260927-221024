function logoutUser() {
    setToken("");

    currentUser = null;

    currentChannel = null;

    updateAccountUI();

    updateBottomAvatar();

    renderChannelUI();

    closeChannel();

    alert("Logged out.");
}


/* =========================================================
   EDIT CHANNEL
   ========================================================= */

function editChannel() {
    if (!currentChannel) return;

    const content =
        document.querySelector("#channelOverlay .channelContent") ||
        document.querySelector("#channelOverlay .channelBody") ||
        document.getElementById("channelContent");

    if (!content) return;

    content.innerHTML = `
        <div class="channelEdit">

            <h2>Edit channel</h2>

            <input
                id="editChannelName"
                type="text"
                value="${escapeHTML(currentChannel.name || "")}"
                placeholder="Channel name"
            >

            <textarea
                id="editChannelDescription"
                placeholder="Channel description"
            >${escapeHTML(currentChannel.description || "")}</textarea>

            <button onclick="saveChannel()">
                Save changes
            </button>

            <button onclick="renderChannelUI()">
                Cancel
            </button>

        </div>
    `;
}


async function saveChannel() {
    if (!currentChannel) return;

    const name =
        document.getElementById("editChannelName")
            ?.value
            ?.trim();

    const description =
        document.getElementById("editChannelDescription")
            ?.value
            ?.trim();

    if (!name) {
        alert("Channel name required.");
        return;
    }

    try {

        const data = await api(
            `/api/channels/${encodeURIComponent(currentChannel.id)}`,
            {
                method: "PUT",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    name,
                    description
                })
            }
        );

        currentChannel =
            data.channel ||
            data;

        alert("Channel updated.");

        renderChannelUI();

        await loadVideos();

    } catch (error) {

        alert("Channel update failed: " + error.message);
    }
}


