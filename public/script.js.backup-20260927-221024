        <div class="authBox">

            <h2>Welcome to Flickora</h2>

            <p>Login or create your Flickora account.</p>

            <div id="authForms">

                <form id="loginForm">

                    <input
                        id="loginEmail"
                        type="email"
                        placeholder="Email"
                        required
                    >

                    <input
                        id="loginPassword"
                        type="password"
                        placeholder="Password"
                        required
                    >

                    <button type="submit">
                        Login
                    </button>

                </form>

                <button
                    type="button"
                    onclick="showRegisterForm()"
                >
                    Create account
                </button>

            </div>

        </div>
    `;

    const form = document.getElementById("loginForm");

    if (form) {
        form.addEventListener("submit", loginUser);
    }
}


function renderLoggedInChannel() {
    const content =
        document.querySelector("#channelOverlay .channelContent") ||
        document.querySelector("#channelOverlay .channelBody") ||
        document.getElementById("channelContent");

    if (!content) {
        return;
    }

    const channel = currentChannel || {};

    content.innerHTML = `
        <div class="channelProfile">

            <div class="channelAvatar">
                ${
                    channel.avatar_url
                        ? `<img src="${escapeHTML(channel.avatar_url)}">`
                        : escapeHTML(
                            (channel.name || "F")
                                .charAt(0)
                                .toUpperCase()
                        )
                }
            </div>

            <h2>
                ${escapeHTML(channel.name || "Flickora Creator")}
            </h2>

            <p>
                ${escapeHTML(channel.description || "")}
            </p>

            <p>
                ${formatViews(channel.subscribers_count || 0)}
                subscribers
            </p>

            <button onclick="logoutUser()">
                Logout
            </button>

            <button onclick="editChannel()">
                Edit channel
            </button>

        </div>
    `;
}


function showLoginForm() {
    renderLoggedOutChannel();
}


function showRegisterForm() {
    const content =
        document.querySelector("#channelOverlay .channelContent") ||
        document.querySelector("#channelOverlay .channelBody") ||
        document.getElementById("channelContent");

    if (!content) return;

    content.innerHTML = `
        <div class="authBox">

            <h2>Create Flickora account</h2>

            <form id="registerForm">

                <input
                    id="registerUsername"
                    type="text"
                    placeholder="Username"
                    required
                >

                <input
                    id="registerEmail"
                    type="email"
                    placeholder="Email"
                    required
                >

                <input
                    id="registerPassword"
                    type="password"
                    placeholder="Password"
                    minlength="6"
                    required
                >

                <button type="submit">
                    Create account
                </button>

            </form>

            <button
                type="button"
                onclick="showLoginForm()"
            >
                Back to login
            </button>

        </div>
    `;

    const form = document.getElementById("registerForm");

    if (form) {
        form.addEventListener("submit", registerUser);
    }
}


/* =========================================================
   REGISTER
   ========================================================= */

async function registerUser(event) {
    event.preventDefault();

    const username =
        document.getElementById("registerUsername")
            ?.value
            ?.trim();

    const email =
        document.getElementById("registerEmail")
            ?.value
            ?.trim();

    const password =
        document.getElementById("registerPassword")
            ?.value;

    if (!username || !email || !password) {
        alert("Please fill all fields.");
        return;
    }

    try {

        const data = await api(
            "/api/auth/register",
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    username,
                    email,
                    password
                })
            }
        );

        if (data.session?.access_token) {
            setToken(data.session.access_token);
        }

        await loadCurrentUser();

        if (!currentUser) {
            alert(
                "Account created. Please login if email confirmation is required."
            );

            showLoginForm();

            return;
        }

        alert("Account created successfully!");

        renderChannelUI();

    } catch (error) {

        alert("Registration failed: " + error.message);
    }
}


/* =========================================================
   LOGIN
   ========================================================= */

async function loginUser(event) {
    event.preventDefault();

    const email =
        document.getElementById("loginEmail")
            ?.value
            ?.trim();

    const password =
        document.getElementById("loginPassword")
            ?.value;

    if (!email || !password) {
        alert("Enter email and password.");
        return;
    }

    try {

        const data = await api(
            "/api/auth/login",
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    email,
                    password
                })
            }
        );

        if (!data.session?.access_token) {
            throw new Error("Login token was not returned.");
        }

        setToken(data.session.access_token);

        await loadCurrentUser();

        alert("Login successful!");

        renderChannelUI();

        updateBottomAvatar();

    } catch (error) {

        alert("Login failed: " + error.message);
    }
}


/* =========================================================
   LOGOUT
