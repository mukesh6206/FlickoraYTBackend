<body>

<header class="header">
  <div class="logo" id="flickoraSecurityLogo" title="">
    <div class="logoPlay">
      <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
    </div>
    Flickora
  </div>

  <div class="headerSpace"></div>

  <button
    class="headerIcon"
    id="notificationButton"
    type="button"
    aria-label="Notifications">

    <svg viewBox="0 0 24 24">
      <path d="M6 8a6 6 0 0112 0c0 7 3 7 3 9H3c0-2 3-2 3-9"/>
      <path d="M10 21h4"/>
    </svg>

    <span class="badge" id="notificationBadge" style="display:none">0</span>
  </button>

  <button class="headerIcon">
    <svg viewBox="0 0 24 24">
      <circle cx="11" cy="11" r="7"/>
      <path d="M20 20l-4-4"/>
    </svg>
  </button>
</header>


<div class="categories">
  <button class="category active">All</button>
  <button class="category">Music</button>
  <button class="category">Security</button>
  <button class="category">Hacking</button>
  <button class="category">Gaming</button>
  <button class="category">News</button>
</div>


<section id="homePage" class="page active">
