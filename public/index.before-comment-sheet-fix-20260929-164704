<script>
(function(){

window.playAdjacentVideo = function(direction){
  if(direction < 0){
    if(typeof playPrevious === "function"){
      playPrevious();
    }
  }else{
    if(typeof playNext === "function"){
      playNext();
    }
  }
};

function addFlickoraButtons(){

  const box = document.getElementById("playerVideoBox");
  const video = document.getElementById("playerVideo");

  if(!box || !video) return;

  if(document.getElementById("flickoraThreeControls")) return;

  const controls = document.createElement("div");
  controls.id = "flickoraThreeControls";

  controls.innerHTML = `
    <button type="button" id="flickoraBackBtn" aria-label="Previous">
      <svg viewBox="0 0 24 24">
        <path d="M19 5v14"/>
        <path d="M5 12l10-7v14z"/>
      </svg>
    </button>

    <button type="button" id="flickoraPauseBtn" aria-label="Play">
      <svg viewBox="0 0 24 24">
        <path d="M8 5v14l11-7z"/>
      </svg>
    </button>

    <button type="button" id="flickoraNextBtn" aria-label="Next">
      <svg viewBox="0 0 24 24">
        <path d="M5 5v14"/>
        <path d="M19 12L9 5v14z"/>
      </svg>
    </button>
  `;

  box.appendChild(controls);

  /* Timeline */
  const timelineWrap = document.createElement("div");
  timelineWrap.id = "flickoraTimelineWrap";

  timelineWrap.innerHTML = `
    <div id="flickoraTimeline">
      <div id="flickoraProgress"></div>
      <div id="flickoraThumb"></div>
    </div>
  `;

  box.appendChild(timelineWrap);

  const timeText = document.createElement("span");
  timeText.id = "flickoraTime";
  timeText.textContent = "0:00 / 0:00";
  box.appendChild(timeText);

  /* Landscape / fullscreen */
  const fullscreenBtn = document.createElement("button");
  fullscreenBtn.type = "button";
  fullscreenBtn.id = "flickoraFullscreenBtn";
  fullscreenBtn.setAttribute("aria-label","Fullscreen");

  fullscreenBtn.innerHTML = `
    <svg viewBox="0 0 24 24">
      <path d="M4 9V4h5"/>
      <path d="M20 9V4h-5"/>
      <path d="M4 15v5h5"/>
      <path d="M20 15v5h-5"/>
    </svg>
  `;

  box.appendChild(fullscreenBtn);

  const progress = document.getElementById("flickoraProgress");
  const thumb = document.getElementById("flickoraThumb");

  function formatFlickoraTime(value){
    if(!Number.isFinite(value)) return "0:00";

    value = Math.max(0, Math.floor(value));

    const minutes = Math.floor(value / 60);
    const seconds = String(value % 60).padStart(2,"0");

    return minutes + ":" + seconds;
  }

  function updateFlickoraTimeline(){
    const duration = video.duration || 0;
    const current = video.currentTime || 0;

    const percent =
      duration > 0 ? Math.min(100, (current / duration) * 100) : 0;

    progress.style.width = percent + "%";
    thumb.style.left = percent + "%";

    timeText.textContent =
      formatFlickoraTime(current) +
      " / " +
      formatFlickoraTime(duration);
  }

  video.addEventListener("timeupdate", updateFlickoraTimeline);
  video.addEventListener("loadedmetadata", updateFlickoraTimeline);
  video.addEventListener("durationchange", updateFlickoraTimeline);

  timelineWrap.addEventListener("click", function(e){
    e.stopPropagation();

    const rect = timelineWrap.getBoundingClientRect();

    const x = Math.max(
      0,
      Math.min(e.clientX - rect.left, rect.width)
    );

    if(video.duration){
      video.currentTime =
        video.duration * (x / rect.width);
    }
  });

  fullscreenBtn.addEventListener("click", async function(e){
    e.stopPropagation();

    try{
      if(!document.fullscreenElement){

        await box.requestFullscreen();

        try{
          if(
            screen.orientation &&
            screen.orientation.lock
          ){
            await screen.orientation.lock("landscape");
          }
        }catch(err){}

      }else{
        await document.exitFullscreen();
      }
    }catch(err){
      console.log("Fullscreen not available");
    }
  });


  const back = document.getElementById("flickoraBackBtn");
  const pause = document.getElementById("flickoraPauseBtn");
  const next = document.getElementById("flickoraNextBtn");

  back.onclick = function(e){
    e.stopPropagation();

    if(typeof playAdjacentVideo === "function"){
      playAdjacentVideo(-1);
    }
  };

  next.onclick = function(e){
    e.stopPropagation();

    if(typeof playAdjacentVideo === "function"){
      playAdjacentVideo(1);
    }
  };

  pause.onclick = function(e){
    e.stopPropagation();

    if(video.paused){
      video.play();
    }else{
      video.pause();
    }
  };

  video.addEventListener("play", function(){
    pause.innerHTML = `
      <svg viewBox="0 0 24 24">
        <path d="M7 5v14"/>
        <path d="M17 5v14"/>
      </svg>
    `;
  });

  video.addEventListener("pause", function(){
    pause.innerHTML = `
      <svg viewBox="0 0 24 24">
        <path d="M8 5v14l11-7z"/>
      </svg>
    `;
  });
}

if(document.readyState === "loading"){
  document.addEventListener("DOMContentLoaded", addFlickoraButtons);
}else{
  addFlickoraButtons();
}

})();
</script>


<style>
/* Hide ONLY the old player buttons */
#playerPrevBtn,
#playerNextBtn {
  display:none !important;
}

/* Keep ONLY the new 3-button controller */
#flickoraThreeControls {
  display:flex !important;
}
</style>

