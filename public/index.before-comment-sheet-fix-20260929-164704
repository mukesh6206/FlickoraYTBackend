<!-- UPLOAD -->

<div id="uploadOverlay" class="overlay">

  <div class="uploadSheet">

    <button class="closeSheet" onclick="closeUpload()">×</button>

    <div class="sheetHandle"></div>

    <h2>Create on Flickora</h2>

    <div class="createOptions">

      <button class="createOption" onclick="chooseType('video')">
        <svg viewBox="0 0 24 24">
          <rect x="3" y="5" width="18" height="14" rx="2"/>
          <path d="M10 9l5 3-5 3z"/>
        </svg>
        Video
      </button>

      <button class="createOption" onclick="chooseType('short')">
        <svg viewBox="0 0 24 24">
          <rect x="7" y="3" width="10" height="18" rx="2"/>
          <path d="M10 8l5 4-5 4z"/>
        </svg>
        Short
      </button>

      <button class="createOption" onclick="chooseType('live')">
        <svg viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="3"/>
          <circle cx="12" cy="12" r="8"/>
        </svg>
        Live
      </button>

      <button class="createOption" onclick="chooseType('post')">
        <svg viewBox="0 0 24 24">
          <path d="M4 5h16v14H4z"/>
          <path d="M7 9h10M7 13h7"/>
        </svg>
        Post
      </button>

    </div>


    <form id="uploadForm" class="form">

      <input id="title" class="input" placeholder="Title" required>

      <textarea id="description"
        class="input"
        placeholder="Description"
        rows="3"></textarea>

      <input id="hashtags"
        class="input"
        placeholder="#hashtags">

      <div class="fileBox">
        <label>Choose video</label>
        <input id="videoFile"
          type="file"
          accept="video/*"
          required>
      </div>

      <div class="fileBox">
        <label>Choose thumbnail</label>
        <input id="thumbnailFile"
          type="file"
          accept="image/*">
      </div>

      <input type="hidden" id="type">

      <button class="uploadAction" type="submit">
        Upload to Flickora
      </button>

      <p id="status"></p>

    </form>
<form id="postForm" class="form">

  <textarea
    id="postContent"
    class="input"
    placeholder="Write something..."
    rows="5"
    maxlength="5000"
    required
  ></textarea>

  <div class="fileBox">
    <label>Add photo (optional)</label>
