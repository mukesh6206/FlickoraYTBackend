<script>
(function(){

  const preview = document.getElementById("commentsPreview");
  const sheet = document.getElementById("flickoraCommentsSheet");
  const closeBtn = document.getElementById("closeCommentsSheet");
  const input = document.getElementById("flickoraCommentInput");
  const send = document.getElementById("flickoraCommentSend");

  if(!preview || !sheet) return;

  preview.addEventListener("click", function(){
    sheet.classList.add("show");
  });

  closeBtn.addEventListener("click", function(){
    sheet.classList.remove("show");
  });

  send.addEventListener("click", function(){
    const text = input.value.trim();

    if(!text) return;

    const list = sheet.querySelector(".flickoraCommentsList");

    const item = document.createElement("div");
    item.className = "flickoraSheetComment";

    item.innerHTML = `
      <div class="commentAvatar">F</div>
      <div class="flickoraSheetCommentText">
        <b>Flickora User</b>
        <p></p>
        <div class="flickoraCommentActions">
          ♡ 0 &nbsp;&nbsp; 💬 Reply
        </div>
      </div>
      <span>•••</span>
    `;

    item.querySelector("p").textContent = text;

    list.prepend(item);

    input.value = "";
  });

})();
</script>
