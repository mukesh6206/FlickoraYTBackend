*{
box-sizing:border-box;
margin:0;
padding:0;
-webkit-tap-highlight-color:transparent;
}

body{
font-family:Arial,Helvetica,sans-serif;
background:#fff;
color:#0f0f0f;
padding-bottom:72px;
}

button{
border:0;
background:none;
cursor:pointer;
color:inherit;
}

svg{
width:26px;
height:26px;
fill:none;
stroke:currentColor;
stroke-width:2;
stroke-linecap:round;
stroke-linejoin:round;
}

/* HEADER */

.header{
height:64px;
display:flex;
align-items:center;
padding:0 16px;
gap:18px;
position:sticky;
top:0;
z-index:50;
background:#fff;
}

.logo{
display:flex;
align-items:center;
gap:7px;
font-size:23px;
font-weight:700;
letter-spacing:-1px;
}

.logoPlay{
width:42px;
height:29px;
border-radius:9px;
background:#ff0033;
display:flex;
align-items:center;
justify-content:center;
color:#fff;
}

.logoPlay svg{
width:17px;
height:17px;
fill:white;
stroke:none;
}

.headerSpace{
flex:1;
}

.headerIcon{
position:relative;
}

.badge{
position:absolute;
top:-7px;
right:-8px;
background:#ff0033;
color:#fff;
font-size:11px;
min-width:23px;
height:20px;
border-radius:12px;
display:flex;
align-items:center;
justify-content:center;
font-weight:bold;
}

/* CATEGORIES */

.categories{
display:flex;
gap:10px;
padding:7px 16px 13px;
overflow-x:auto;
scrollbar-width:none;
background:#fff;
}

.categories::-webkit-scrollbar{
display:none;
}

.category{
background:#f2f2f2;
padding:10px 18px;
border-radius:12px;
white-space:nowrap;
font-size:16px;
}

.category.active{
background:#111;
color:white;
}

/* PAGE */

.page{
display:none;
}

.page.active{
display:block;
}

/* HOME */

.videoCard{
margin-bottom:14px;
background:#fff;
cursor:pointer;
}

.thumb{
width:100%;
aspect-ratio:16/9;
object-fit:cover;
background:#ddd;
display:block;
}

.videoInfo{
display:flex;
gap:12px;
padding:11px 14px 10px;
}

.avatar{
width:40px;
height:40px;
border-radius:50%;
background:#ddd;
flex-shrink:0;
display:flex;
align-items:center;
justify-content:center;
font-weight:bold;
overflow:hidden;
}

.avatar img{
width:100%;
height:100%;
object-fit:cover;
}

.videoText{
min-width:0;
flex:1;
}

.videoTitle{
font-size:17px;
font-weight:700;
line-height:1.25;
display:-webkit-box;
-webkit-line-clamp:2;
-webkit-box-orient:vertical;
overflow:hidden;
}

.meta{
color:#606060;
font-size:14px;
margin-top:7px;
line-height:1.35;
}

.moreBtn{
font-size:25px;
}

/* SHORTS */

.shortsPage{
background:#000;
min-height:calc(100vh - 136px);
}

.shortCard{
position:relative;
height:calc(100vh - 136px);
background:#111;
overflow:hidden;
}

.shortVideo{
width:100%;
height:100%;
object-fit:cover;
}

.shortInfo{
position:absolute;
left:14px;
right:75px;
bottom:20px;
color:#fff;
text-shadow:0 1px 5px #000;
}

.shortTitle{
font-size:18px;
font-weight:bold;
margin-bottom:8px;
}

.shortChannel{
font-size:14px;
}

.shortActions{
position:absolute;
right:12px;
bottom:45px;
display:flex;
flex-direction:column;
gap:20px;
color:#fff;
}

.shortAction{
display:flex;
flex-direction:column;
align-items:center;
gap:4px;
font-size:12px;
}

.shortAction svg{
width:30px;
height:30px;
color:white;
}

/* BOTTOM */

.bottom{
position:fixed;
left:0;
right:0;
bottom:0;
height:72px;
background:#fff;
border-top:1px solid #ddd;
display:flex;
justify-content:space-around;
align-items:center;
z-index:100;
}

.navItem{
width:20%;
height:65px;
display:flex;
flex-direction:column;
align-items:center;
justify-content:center;
gap:3px;
font-size:11px;
}

.navItem svg{
width:25px;
height:25px;
}

.navItem.active{
font-weight:bold;
}

.plus{
width:54px;
height:44px;
border:1px solid #bbb;
border-radius:24px;
display:flex;
align-items:center;
justify-content:center;
}

/* UPLOAD */

.overlay{
position:fixed;
inset:0;
background:rgba(0,0,0,.55);
z-index:200;
display:none;
align-items:flex-end;
}

.overlay.show{
display:flex;
}

.uploadSheet{
width:100%;
background:#fff;
border-radius:22px 22px 0 0;
padding:20px 18px 30px;
max-height:90vh;
overflow:auto;
position:relative;
}

.sheetHandle{
width:45px;
height:5px;
border-radius:5px;
background:#ccc;
margin:0 auto 18px;
}

.uploadSheet h2{
margin-bottom:17px;
}

.createOptions{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:10px;
margin-bottom:20px;
}

.createOption{
background:#f3f3f3;
border-radius:14px;
padding:14px 5px;
text-align:center;
font-size:13px;
}

.createOption svg{
display:block;
margin:auto auto 7px;
}

.form{
display:none;
}

.form.show{
display:block;
}

.input{
width:100%;
border:1px solid #ccc;
border-radius:10px;
padding:13px;
margin-bottom:10px;
font-size:15px;
font-family:inherit;
}

.fileBox{
border:1px dashed #aaa;
border-radius:12px;
padding:13px;
margin-bottom:10px;
}

.fileBox label{
display:block;
font-weight:bold;
margin-bottom:8px;
}

.uploadAction{
width:100%;
background:#111;
color:#fff;
padding:14px;
border-radius:10px;
font-size:16px;
font-weight:bold;
}

#status{
text-align:center;
margin-top:10px;
color:#555;
}

.closeSheet{
position:absolute;
right:18px;
top:15px;
font-size:28px;
}

/* PLAYER */

.playerOverlay{
position:fixed;
inset:0;
background:#fff;
z-index:300;
display:none;
overflow-y:auto;
}

.playerOverlay.show{
display:block;
}

.playerTop{
height:55px;
display:flex;
align-items:center;
padding:0 14px;
gap:15px;
background:#fff;
position:sticky;
top:0;
z-index:5;
}

.playerClose{
margin-left:auto;
font-size:28px;
}

.playerVideoBox{
background:#000;
width:100%;
aspect-ratio:16/9;
position:sticky;
top:55px;
z-index:4;
}

.playerVideo{
width:100%;
height:100%;
object-fit:contain;
}

.playerDetails{
padding:15px;
}

.playerTitle{
font-size:21px;
font-weight:bold;
line-height:1.25;
}

.channelRow{
display:flex;
align-items:center;
gap:10px;
margin-top:15px;
}

.channelName{
font-weight:bold;
flex:1;
}

.subscribe{
background:#111;
color:#fff;
padding:10px 18px;
border-radius:22px;
font-weight:bold;
}

.subscribe.subscribed{
background:#eee;
color:#111;
}

.actionRow{
display:flex;
gap:18px;
margin-top:17px;
overflow-x:auto;
}

.action{
display:flex;
flex-direction:column;
align-items:center;
gap:4px;
min-width:48px;
font-size:12px;
}

.action svg{
width:25px;
height:25px;
}

.comments{
margin-top:20px;
background:#f3f3f3;
border-radius:16px;
padding:16px;
}

.comments h3{
margin-bottom:15px;
}

.comment{
display:flex;
gap:10px;
align-items:flex-start;
}

.commentAvatar{
width:35px;
height:35px;
border-radius:50%;
background:#ddd;
display:flex;
align-items:center;
justify-content:center;
}

.commentInput{
margin-top:15px;
width:100%;
border:0;
border-bottom:1px solid #aaa;
padding:10px 3px;
outline:none;
background:transparent;
}

/* RECOMMENDED */

.recommendedSection{
width:100%;
background:#fff;
padding:18px 0 100px;
}

.recommendedSection h2{
font-size:21px;
padding:0 15px 14px;
}

.recommendedCard{
width:100%;
display:block;
background:#fff;
margin-bottom:18px;
cursor:pointer;
}

.recommendedThumb{
width:100%;
aspect-ratio:16/9;
display:block;
object-fit:cover;
background:#ddd;
}

.recommendedText{
position:relative;
min-height:82px;
padding:11px 45px 10px 65px;
}

.recommendedText::before{
content:"F";
position:absolute;
left:15px;
top:12px;
width:40px;
height:40px;
border-radius:50%;
background:#ddd;
display:flex;
align-items:center;
justify-content:center;
font-weight:bold;
}

.recommendedTitle{
font-size:17px;
font-weight:700;
line-height:1.28;
}

.recommendedMeta{
margin-top:6px;
color:#606060;
font-size:14px;
}

.recommendedMore{
position:absolute;
right:12px;
top:10px;
font-size:25px;
}

.empty{
padding:50px 20px;
text-align:center;
color:#666;
}

/* MINI PLAYER */

.playerOverlay.miniMode{
position:fixed;
inset:auto;
right:10px;
bottom:82px;
width:320px;
background:#000;
z-index:500;
border-radius:10px;
overflow:hidden;
box-shadow:0 4px 20px rgba(0,0,0,.55);
display:block;
}

.playerOverlay.miniMode .playerTop,
.playerOverlay.miniMode .playerDetails,
.playerOverlay.miniMode .recommendedSection{
display:none;
}

.playerOverlay.miniMode .playerVideoBox{
width:100%;
aspect-ratio:16/9;
position:relative;
top:auto;
}

.miniClose,
.miniRestore{
display:none;
position:absolute;
top:7px;
width:30px;
height:30px;
border-radius:50%;
background:rgba(0,0,0,.65);
color:#fff;
z-index:20;
align-items:center;
justify-content:center;
font-size:20px;
}

.miniClose{
right:7px;
}

.miniRestore{
right:43px;
}

.playerOverlay.miniMode .miniClose,
.playerOverlay.miniMode .miniRestore{
display:flex;
}

/* CHANNEL */

.channelOverlay{
position:fixed;
inset:0;
background:#fff;
z-index:1000;
display:none;
overflow-y:auto;
}

.channelOverlay.show{
display:block;
}

.channelTop{
height:58px;
display:flex;
align-items:center;
gap:12px;
padding:0 15px;
position:sticky;
top:0;
z-index:5;
background:#fff;
border-bottom:1px solid #eee;
}

.channelTop button{
font-size:28px;
}

.channelTop b{
font-size:19px;
}

.channelBanner{
height:155px;
background:linear-gradient(
135deg,
#111827,
#4f46e5,
#7c3aed
);
}

.channelProfile{
padding:0 18px 20px;
margin-top:-45px;
}

.channelBigAvatar{
width:90px;
height:90px;
border-radius:50%;
background:#ddd;
border:5px solid #fff;
display:flex;
align-items:center;
justify-content:center;
font-size:38px;
font-weight:bold;
overflow:hidden;
}

.channelBigAvatar img{
width:100%;
height:100%;
object-fit:cover;
}

.channelBigName{
font-size:25px;
font-weight:800;
margin-top:10px;
}

.channelHandle{
color:#666;
margin-top:4px;
}

.channelDescription{
margin-top:12px;
color:#444;
line-height:1.5;
}

.channelStats{
margin-top:10px;
font-weight:bold;
}

.channelEdit{
margin-top:14px;
padding:11px 18px;
border-radius:22px;
background:#111;
color:#fff;
font-weight:bold;
}

.channelVideosTitle{
padding:15px 18px;
font-size:21px;
font-weight:bold;
}

.channelVideoCard{
margin-bottom:18px;
cursor:pointer;
}

.channelVideoThumb{
width:100%;
aspect-ratio:16/9;
object-fit:cover;
background:#ddd;
display:block;
}

.channelVideoInfo{
padding:10px 15px;
}

.channelVideoTitle{
font-size:17px;
font-weight:bold;
}

.channelVideoMeta{
margin-top:6px;
color:#666;
font-size:14px;
}

.channelForm{
padding:20px;
}

.channelForm h2{
margin-bottom:10px;
}

.channelForm p{
color:#666;
margin-bottom:20px;
}

.channelInput{
width:100%;
padding:13px;
border:1px solid #ccc;
border-radius:10px;
margin-bottom:12px;
font-size:15px;
font-family:inherit;
}

.channelForm textarea{
min-height:100px;
resize:vertical;
}

.channelSubmit{
width:100%;
padding:14px;
border-radius:10px;
background:#111;
color:#fff;
font-weight:bold;
font-size:16px;
}

.channelCancel{
width:100%;
padding:13px;
margin-top:10px;
border:1px solid #ccc;
border-radius:10px;
}

@media(max-width:500px){
.playerOverlay.miniMode{
width:290px;
right:8px;
bottom:78px;
}
}

@media(min-width:700px){
body{
max-width:900px;
margin:auto;
border-left:1px solid #eee;
border-right:1px solid #eee;
}

.bottom{
max-width:900px;
margin:auto;
}
}
